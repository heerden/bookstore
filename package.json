    "lint:check": "npm run lint:check --workspace=packages/api",
    "build": "npm run build --workspace=packages/api",
    "start": "npm run start --workspace=packages/api",
    "test": "npm run test --workspace=packages/api",
    "test:watch": "npm run test:watch --workspace=packages/api",
    "test:cov": "npm run test:cov --workspace=packages/api",
    "test:e2e": "npm run test:e2e --workspace=packages/api"
  },
